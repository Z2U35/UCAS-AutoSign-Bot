[Unit]
Description=Trigger one bounded UCAS auto-sign tick
Requires=ucas-signin.service
After=ucas-signin.service

[Service]
Type=oneshot
User=ucas
Group=ucas
WorkingDirectory=/opt/ucas-autosign-bot
Environment=NODE_ENV=production
EnvironmentFile=-/etc/ucas-signin/auto-sign.env
ExecStart=/usr/local/bin/node /opt/ucas-autosign-bot/scripts/trigger-auto-sign.mjs
TimeoutStartSec=115s
TimeoutStopSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_UNIX
